# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
# For external PostgreSQL (Docker/Production):
DATABASE_URL="postgresql://eventora_user:eventora_secure_pass@localhost:5432/eventora_db?schema=public"
# Local fallback mode: automatically uses embedded ACID database (.data/eventora.db) if DATABASE_URL is not connected.

# Redis & Queues
# For external Redis (Docker/Production):
REDIS_URL="redis://localhost:6379"
# Local fallback mode: uses robust in-process memory queue & cache if REDIS_URL is not connected.

# JWT Authentication
JWT_ACCESS_SECRET="eventora-access-secret-development-key-change-in-production-256bit"
JWT_REFRESH_SECRET="eventora-refresh-secret-development-key-change-in-production-256bit"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Simulation
MOCK_PAYMENT_LATENCY_MS=1200
MOCK_PAYMENT_WEBHOOK_SECRET="mock-payment-signature-secret-key-32chars"

# Gemini AI (Optional platform assistance)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
